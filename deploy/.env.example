# Environnement du déploiement local Accommity (http://localhost:8080)
# Copiez ce fichier vers deploy/.env puis lancez scripts/deploy-local.*
# Le script génère automatiquement APP_KEY si elle est vide.

APP_NAME=Accommity
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=accommity_db
DB_USERNAME=accommity_user
DB_PASSWORD=accommity_password

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notifications@accommity.ma"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080
SANCTUM_EXPIRATION=1440
